<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gochuchamchi.mapper.UserMapper">

  <resultMap id="userResultMap" type="UserDto">
    <id property="id" column="id"/>
    <result property="username" column="username"/>
    <result property="name" column="name"/>
    <result property="email" column="email"/>
    <result property="password" column="password"/>
    <result property="phone" column="phone"/>
    <result property="birthdate" column="birthdate"/>
    <result property="gender" column="gender"/>
    <result property="nationality" column="nationality"/>
    <result property="address" column="address"/>
    <result property="role" column="role"/>
    <result property="createdAt" column="created_at"/>
    <result property="suspendedUntil" column="suspended_until"/>
    <result property="suspendedPermanent" column="suspended_permanent"/>
    <result property="suspendedAt" column="suspended_at"/>
    <result property="suspendedBy" column="suspended_by"/>
  </resultMap>

  <select id="findByUsername" resultMap="userResultMap">
    SELECT * FROM ${userTable} WHERE username = #{username}
  </select>

  <select id="findById" resultMap="userResultMap">
    SELECT * FROM ${userTable} WHERE id = #{id}
  </select>

  <select id="existsByUsername" resultType="boolean">
    SELECT COUNT(*) > 0 FROM ${userTable} WHERE username = #{username}
  </select>

  <select id="existsByEmail" resultType="boolean">
    SELECT COUNT(*) > 0 FROM ${userTable} WHERE email = #{email}
  </select>

  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO ${userTable} (username, name, email, password, phone, birthdate, gender, nationality, address, role, created_at)
    VALUES (#{username}, #{name}, #{email}, #{password}, #{phone}, #{birthdate}, #{gender}, #{nationality}, #{address}, 'user', NOW())
  </insert>

  <update id="update">
    UPDATE ${userTable} SET name=#{name}, email=#{email}, birthdate=#{birthdate},
    phone=#{phone}, gender=#{gender}, nationality=#{nationality}, address=#{address}
    WHERE id=#{id}
  </update>

  <update id="updatePassword">
    UPDATE ${userTable} SET password=#{password} WHERE id=#{id}
  </update>

  <select id="findAllForAdmin" resultMap="userResultMap">
    SELECT * FROM ${userTable} ORDER BY created_at DESC
  </select>

  <update id="updateRole">
    UPDATE ${userTable} SET role=#{role} WHERE id=#{id}
  </update>

  <update id="suspend">
    UPDATE ${userTable} SET
      suspended_until = #{until,jdbcType=TIMESTAMP},
      suspended_permanent = #{permanent},
      suspended_at = NOW(),
      suspended_by = #{actor}
    WHERE id = #{id}
  </update>

  <update id="unsuspend">
    UPDATE ${userTable} SET
      suspended_until = NULL,
      suspended_permanent = 0,
      suspended_at = NULL,
      suspended_by = NULL
    WHERE id = #{id}
  </update>

</mapper>
