<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gochuchamchi.mapper.ProductMapper">

  <resultMap id="productResultMap" type="ProductDto">
    <id property="id"           column="id"/>
    <result property="sellerId"     column="seller_id"/>
    <result property="brand"        column="brand"/>
    <result property="name"         column="name"/>
    <result property="category"     column="category"/>
    <result property="price"        column="price"/>
    <result property="stock"        column="stock"/>
    <result property="image"        column="image"/>
    <result property="description"  column="description"/>
    <result property="newItem"      column="new_item"/>
    <result property="active"       column="active"/>
    <result property="viewCount"    column="view_count"/>
    <result property="createdAt"    column="created_at"/>
  </resultMap>

  <select id="findAll" resultMap="productResultMap">
    SELECT * FROM products
    WHERE active = 1
    <if test="category != null and category != ''">AND category = #{category}</if>
    <choose>
      <when test="sort == 'price_asc'">ORDER BY price ASC</when>
      <when test="sort == 'price_desc'">ORDER BY price DESC</when>
      <when test="sort == 'name'">ORDER BY name ASC</when>
      <when test="sort == 'brand'">ORDER BY brand ASC</when>
      <when test="sort == 'popular'">ORDER BY view_count DESC</when>
      <otherwise>ORDER BY created_at DESC</otherwise>
    </choose>
    LIMIT #{limit} OFFSET #{offset}
  </select>

  <select id="findById" resultMap="productResultMap">
    SELECT * FROM products WHERE id = #{id} AND active = 1
  </select>

  <select id="countAll" resultType="int">
    SELECT COUNT(*) FROM products
    WHERE active = 1
    <if test="category != null and category != ''">AND category = #{category}</if>
  </select>

  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO products (seller_id, brand, name, category, price, stock, image, description, new_item, created_at)
    VALUES (#{sellerId}, #{brand}, #{name}, #{category}, #{price}, #{stock}, #{image}, #{description}, 1, NOW())
  </insert>

  <update id="incrementViews">
    UPDATE products SET view_count = view_count + 1 WHERE id = #{id}
  </update>

</mapper>
